APP_NAME="Discount Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=discounts
DB_USERNAME=discounts
DB_PASSWORD=discounts

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAGNIT_STORES_URL=https://magnit.ru/webgate/v1/stores-facade/search/detail
MAGNIT_GOODS_URL=https://magnit.ru/webgate/v2/goods/search
MAGNIT_CATALOG_URL=https://magnit.ru/catalog
# Use one of the predefined MAGNIT_STORE_REGION values from backend/config/services.php
# For example: novokuznetsk or moscow
MAGNIT_STORE_REGION=novokuznetsk
MAGNIT_STORE_BOXES=[{"lat1":53.8727,"lon1":86.8704,"lat2":53.6473,"lon2":87.2796}]
METRO_API_URL=https://api.metro-cc.ru/products-api/graph
METRO_TRADECENTERS_URL=https://api.metro-cc.ru/api/v1/C98BB1B547ECCC17D8AEBEC7116D6/tradecenters
METRO_DEFAULT_STORE_ID=54
METRO_DEFAULT_TRADE_CENTER_ID=55
METRO_DEFAULT_CITY=
METRO_DEFAULT_ADDRESS=
